// version.rc.in —— Windows VERSIONINFO 资源模板
// 由 CMake configure_file(@ONLY) 注入四位版本号，随 DLL 编译，
// 使文件属性“详细信息”中显示文件版本/产品版本。
#include <winver.h>

#define VER_FILEVERSION            @GENERAL_STATE_MACHINE_VERSION_COMMA@
#define VER_FILEVERSION_STR        "@GENERAL_STATE_MACHINE_VERSION@\0"
#define VER_PRODUCTVERSION         @GENERAL_STATE_MACHINE_VERSION_COMMA@
#define VER_PRODUCTVERSION_STR     "@GENERAL_STATE_MACHINE_VERSION@\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @GENERAL_STATE_MACHINE_VERSION_COMMA@
 PRODUCTVERSION @GENERAL_STATE_MACHINE_VERSION_COMMA@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "GeneralStateMachine Project"
            VALUE "FileDescription",  "GeneralStateMachine: independent generic state machine library"
            VALUE "FileVersion",      "@GENERAL_STATE_MACHINE_VERSION@"
            VALUE "InternalName",     "GeneralStateMachine"
            VALUE "LegalCopyright",   "Copyright (C) 2026 GeneralStateMachine Project"
            VALUE "OriginalFilename", "GeneralStateMachine.dll"
            VALUE "ProductName",      "GeneralStateMachine"
            VALUE "ProductVersion",   "@GENERAL_STATE_MACHINE_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
